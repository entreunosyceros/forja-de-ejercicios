FROM ubuntu:22.04
# Contenedor de práctica endurecido (sin privilegios nuevos; caps mínimas vía compose).
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash curl git iproute2 net-tools sudo vim \
    mariadb-client python3 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash alumno \
    && echo "alumno:practica" | chpasswd \
    && usermod -aG sudo alumno \
    && echo "alumno ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers \
    && mkdir -p /home/alumno/practica \
    && chown -R alumno:alumno /home/alumno

WORKDIR /home/alumno/practica
USER alumno

CMD ["/bin/bash"]
