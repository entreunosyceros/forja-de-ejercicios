# Copia este archivo a .env en la misma carpeta (examenforge/.env)
# cp .env.example .env
#
# NO subas .env a GitHub. NO dejes el texto de ejemplo: pega tu clave REAL.

# Clave de https://aistudio.google.com/apikey  (a mi nome la han cobrado la API key)
GEMINI_API_KEY=

# Alternativa (mismo valor):
# FORJAEXAMENES_GEMINI_API_KEY=

# Modelo (opcional; gemini-2.0-flash suele tener cuota 0 en plan gratuito):
FORJAEXAMENES_GEMINI_MODEL=gemini-2.5-flash

# Python (opcional; el instalador lo fija en Windows)
# Usa barras normales en rutas: C:/Program Files/Python313/python.exe
# FORJAEXAMENES_PYTHON_INTERPRETE=C:/Program Files/Python313/python.exe
